# Salin jadi .env.local untuk menjalankan secara lokal.
# Di Vercel, DATABASE_URL otomatis terisi saat database Neon dihubungkan (menu Storage).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
ADMIN_PASSWORD=ganti-dengan-password-admin
# Opsional: API key gratis dari https://carto.com/basemaps/apikey untuk basemap CARTO.
# Kalau kosong, peta memakai OpenStreetMap.
VITE_CARTO_KEY=
