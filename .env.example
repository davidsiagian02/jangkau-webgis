# Salin jadi .env.local untuk menjalankan secara lokal.
# Di Vercel, DATABASE_URL otomatis terisi saat database Neon dihubungkan (menu Storage).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
ADMIN_PASSWORD=ganti-dengan-password-admin
# Opsional: kunci peta CARTO sudah tertanam di src/lib/map.js. Isi ini hanya kalau ingin memakai kunci lain.
VITE_CARTO_KEY=
